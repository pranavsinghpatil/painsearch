{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pranavsinghpatil/painsearch/schema/problem-registry-v1.json",
  "title": "PainSearch Problem Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "updated_at", "problems"],
  "properties": {
    "registry_version": {"const": "1.0"},
    "updated_at": {"type": "string", "format": "date"},
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problem"}}
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "statement", "evidence", "counter_evidence", "investigations", "history"],
      "properties": {
        "id": {"type": "string", "pattern": "^P[0-9]{4}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "investigating", "validated", "rejected", "unresolved"]},
        "statement": {"$ref": "#/$defs/statement"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "counter_evidence": {"type": "array", "items": {"type": "string"}},
        "investigations": {"type": "array", "items": {"$ref": "#/$defs/investigation"}},
        "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "task", "failure", "consequence"],
      "properties": {
        "user": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1},
        "consequence": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_url", "quote", "supports", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[0-9]{4}$"},
        "kind": {"enum": ["report", "workaround", "consequence", "counter_report", "solution"]},
        "source_url": {"type": "string", "format": "uri"},
        "quote": {"type": "string", "minLength": 1},
        "supports": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_published_at", "collected_at", "verified_at", "independence_group", "corroboration_status"],
      "properties": {
        "source_published_at": {"$ref": "#/$defs/date_or_datetime_or_null"},
        "collected_at": {"type": "string", "format": "date-time"},
        "verified_at": {"$ref": "#/$defs/date_or_datetime_or_null"},
        "independence_group": {"type": "string", "minLength": 1},
        "corroboration_status": {"enum": ["unassessed", "independent", "same_source", "corroborates", "contradicts"]}
      }
    },
    "date_or_datetime_or_null": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "format": "date"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "status", "next_action"],
      "properties": {
        "id": {"type": "string", "pattern": "^I[0-9]{4}$"},
        "question": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "answered", "blocked"]},
        "method": {"type": "string"},
        "finding": {"type": "string"},
        "next_action": {"type": "string", "minLength": 1}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "actor", "event", "from_status", "to_status", "reason"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "event": {"const": "status_changed"},
        "from_status": {"anyOf": [{"type": "null"}, {"enum": ["candidate", "investigating", "validated", "rejected", "unresolved"]}]},
        "to_status": {"enum": ["candidate", "investigating", "validated", "rejected", "unresolved"]},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
